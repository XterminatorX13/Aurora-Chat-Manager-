{
  "name": "umbra",
  "productName": "Umbra",
  "private": true,
  "version": "2.0.0",
  "description": "Seu PKM minimalista, lindo e pessoal",
  "author": "Your Name",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "bun scripts/dev.js",
    "vite": "vite",
    "electron": "electron",
    "build": "vite build",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win --x64",
    "electron:build:portable": "vite build && electron-builder --win portable"
  },
  "devDependencies": {
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.25",
    "svelte": "^5.56.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-bubble-menu": "^3.29.2",
    "@tiptap/extension-floating-menu": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "dexie": "^4.4.4",
    "emoji-picker-element": "^1.29.1",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.7",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.10",
    "openai": "^7.3.0"
  },
  "build": {
    "appId": "com.umbra.app",
    "productName": "Umbra",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Umbra"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [],
    "asar": true,
    "compression": "maximum"
  }
}